{
    "productName": "IronBridge",
    "version": "2.0.1",
    "identifier": "com.nervosys.ironbridge",
    "build": {
        "beforeDevCommand": "cd ../ironbridge-web && npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "cd ../ironbridge-web && npm run build",
        "frontendDist": "../ironbridge-web/dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "IronBridge",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "center": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8787 http://127.0.0.1:8788 http://localhost:8787 http://localhost:8788 ws://127.0.0.1:8787 ws://127.0.0.1:8788 ws://localhost:8787 ws://localhost:8788; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        "trayIcon": {
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "macOS": {
            "minimumSystemVersion": "10.15"
        },
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}