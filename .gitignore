# Chat System Manager (CSM)

# Rust build artifacts
csm-rust/target/
chasm-rust/target/
chasm-desktop/target/
**/*.rs.bk
**/*.pdb
# Note: Cargo.lock IS committed for reproducible builds (this is a binary, not a library)

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Archive (legacy development code with hardcoded paths - exclude from release)
archive/

# Test artifacts
*.log
*.tmp
*.bak

# Database files (may contain private chat data)
*.db
*.sqlite
*.sqlite3
chat_sessions.db

# Demo exports
/exports/

# VS Code extension build artifacts
vscode-extension/out/
vscode-extension/node_modules/
vscode-extension/.vscode-test/
vscode-extension/*.vsix
vscode-extension/bin/

# Python
__pycache__/
*.pyc
*.pyo
.env
.env.*
venv/

# Node dependencies (built artifacts stay)
**/node_modules/

# Secrets and credentials (never commit these)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*secret*
*credential*
*password*
config.local.json
.secrets/

# API keys and tokens
.api_key
.token
*.apikey

# Debug/test files (may contain private chat data)
**/raw_session.json
**/session_sample.txt
**/test_output.json
**/*_log.txt
**/*_out.txt
**/*_err.txt
