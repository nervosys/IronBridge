{
    "name": "chasm",
    "displayName": "Chasm",
    "description": "Universal AI chat session manager — harvest, repair, merge, and search across VS Code, Cursor, Claude Code, and 30+ providers",
    "version": "1.0.0",
    "publisher": "nervosys",
    "icon": "resources/icon.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Machine Learning",
        "Data Science",
        "Other"
    ],
    "keywords": [
        "chasm",
        "chat",
        "session",
        "ai",
        "copilot",
        "cursor",
        "claude",
        "harvest",
        "merge",
        "search"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "Chasm",
            "properties": {
                "chasm.binaryPath": {
                    "type": "string",
                    "default": "chasm",
                    "description": "Path to chasm binary (or just 'chasm' if in PATH)",
                    "scope": "machine"
                },
                "chasm.showNotifications": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show notifications for operations"
                },
                "chasm.api.baseUrl": {
                    "type": "string",
                    "default": "http://localhost:3000",
                    "description": "Base URL for Chasm API server"
                },
                "chasm.api.autoStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically start API server when extension activates"
                },
                "chasm.recording.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable real-time session recording to prevent data loss"
                },
                "chasm.recording.providers": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "vscode",
                            "cursor",
                            "continuedev",
                            "claude-code",
                            "opencode",
                            "openclaw",
                            "antigravity",
                            "windsurf",
                            "zed",
                            "codespaces",
                            "codex-cli",
                            "droid-cli",
                            "gemini-cli"
                        ]
                    },
                    "default": [
                        "vscode",
                        "cursor"
                    ],
                    "description": "AI chat providers to record sessions from"
                },
                "chasm.doctor.runOnStartup": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run health check on startup and show issues in status bar"
                },
                "chasm.statusBar.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Chasm status in the status bar"
                }
            }
        },
        "commands": [
            {
                "command": "chasm.openChat",
                "title": "Chasm: Open Chat",
                "icon": "$(comment-discussion)",
                "category": "Chasm"
            },
            {
                "command": "chasm.showWorkspaces",
                "title": "Chasm: Show All Workspaces",
                "icon": "$(list-tree)",
                "category": "Chasm"
            },
            {
                "command": "chasm.showSessions",
                "title": "Chasm: Show Sessions for Current Workspace",
                "icon": "$(comment-discussion)",
                "category": "Chasm"
            },
            {
                "command": "chasm.showHistory",
                "title": "Chasm: Show Chat History",
                "icon": "$(history)",
                "category": "Chasm"
            },
            {
                "command": "chasm.findWorkspace",
                "title": "Chasm: Find Workspace",
                "icon": "$(search)",
                "category": "Chasm"
            },
            {
                "command": "chasm.exportSessions",
                "title": "Chasm: Export Sessions",
                "icon": "$(export)",
                "category": "Chasm"
            },
            {
                "command": "chasm.importSessions",
                "title": "Chasm: Import Sessions",
                "icon": "$(import)",
                "category": "Chasm"
            },
            {
                "command": "chasm.fetchHistory",
                "title": "Chasm: Fetch History from Other Workspaces",
                "icon": "$(cloud-download)",
                "category": "Chasm"
            },
            {
                "command": "chasm.mergeHistory",
                "title": "Chasm: Merge All Sessions",
                "icon": "$(git-merge)",
                "category": "Chasm"
            },
            {
                "command": "chasm.refresh",
                "title": "Chasm: Refresh",
                "icon": "$(refresh)",
                "category": "Chasm"
            },
            {
                "command": "chasm.reloadAndShowChats",
                "title": "Chasm: Reload Window and Show Chats",
                "icon": "$(refresh)",
                "category": "Chasm"
            },
            {
                "command": "chasm.launchTui",
                "title": "Chasm: Launch TUI",
                "icon": "$(terminal)",
                "category": "Chasm"
            },
            {
                "command": "chasm.moveSessions",
                "title": "Chasm: Move Sessions to Another Workspace",
                "icon": "$(move)",
                "category": "Chasm"
            },
            {
                "command": "chasm.doctor",
                "title": "Chasm: Run Health Check",
                "icon": "$(heart)",
                "category": "Chasm"
            },
            {
                "command": "chasm.doctorFix",
                "title": "Chasm: Fix All Session Issues",
                "icon": "$(wrench)",
                "category": "Chasm"
            },
            {
                "command": "chasm.doctorDryRun",
                "title": "Chasm: Preview Repairs (Dry Run)",
                "icon": "$(eye)",
                "category": "Chasm"
            },
            {
                "command": "chasm.registerRepair",
                "title": "Chasm: Repair All Sessions",
                "icon": "$(tools)",
                "category": "Chasm"
            },
            {
                "command": "chasm.registerRepairRecursive",
                "title": "Chasm: Repair Sessions (Recursive Scan)",
                "icon": "$(folder-library)",
                "category": "Chasm"
            },
            {
                "command": "chasm.startServer",
                "title": "Chasm: Start API Server",
                "icon": "$(server-process)",
                "category": "Chasm"
            },
            {
                "command": "chasm.stopServer",
                "title": "Chasm: Stop API Server",
                "icon": "$(stop)",
                "category": "Chasm"
            },
            {
                "command": "chasm.recoverScan",
                "title": "Chasm: Scan for Recoverable Sessions",
                "icon": "$(search)",
                "category": "Chasm"
            },
            {
                "command": "chasm.recoverOrphans",
                "title": "Chasm: List Orphaned Sessions",
                "icon": "$(warning)",
                "category": "Chasm"
            },
            {
                "command": "chasm.syncPull",
                "title": "Chasm: Sync Pull (Backup to Database)",
                "icon": "$(cloud-download)",
                "category": "Chasm"
            },
            {
                "command": "chasm.syncPush",
                "title": "Chasm: Sync Push (Restore from Database)",
                "icon": "$(cloud-upload)",
                "category": "Chasm"
            },
            {
                "command": "chasm.upgradeFormat",
                "title": "Chasm: Upgrade Session Format",
                "icon": "$(arrow-up)",
                "category": "Chasm"
            },
            {
                "command": "chasm.gitInit",
                "title": "Chasm: Initialize Git Versioning",
                "icon": "$(git-branch-create)",
                "category": "Chasm"
            },
            {
                "command": "chasm.gitAdd",
                "title": "Chasm: Stage & Commit Sessions",
                "icon": "$(git-commit)",
                "category": "Chasm"
            },
            {
                "command": "chasm.gitStatus",
                "title": "Chasm: Show Git Status",
                "icon": "$(git-compare)",
                "category": "Chasm"
            },
            {
                "command": "chasm.gitSnapshot",
                "title": "Chasm: Create Git Snapshot",
                "icon": "$(tag)",
                "category": "Chasm"
            },
            {
                "command": "chasm.createMigration",
                "title": "Chasm: Create Migration Package",
                "icon": "$(package)",
                "category": "Chasm"
            },
            {
                "command": "chasm.restoreMigration",
                "title": "Chasm: Restore Migration Package",
                "icon": "$(folder-opened)",
                "category": "Chasm"
            },
            {
                "command": "chasm.showVersion",
                "title": "Chasm: Show Version",
                "icon": "$(info)",
                "category": "Chasm"
            },
            {
                "command": "chasm.loadSession",
                "title": "View Session",
                "icon": "$(open-preview)"
            },
            {
                "command": "chasm.mergeSessionsForWorkspace",
                "title": "Merge All Sessions",
                "icon": "$(git-merge)"
            },
            {
                "command": "chasm.fetchSessionsForWorkspace",
                "title": "Fetch from Other Workspaces",
                "icon": "$(cloud-download)"
            },
            {
                "command": "chasm.copySessionId",
                "title": "Copy Session ID",
                "icon": "$(clippy)"
            },
            {
                "command": "chasm.viewSessionDetails",
                "title": "View Session Details",
                "icon": "$(info)"
            },
            {
                "command": "chasm.harvest",
                "title": "Chasm: Harvest Sessions",
                "icon": "$(cloud-download)",
                "category": "Chasm"
            },
            {
                "command": "chasm.harvestScan",
                "title": "Chasm: Scan for Providers",
                "icon": "$(search)",
                "category": "Chasm"
            },
            {
                "command": "chasm.harvestSearch",
                "title": "Chasm: Full-Text Search (Harvest DB)",
                "icon": "$(search)",
                "category": "Chasm"
            },
            {
                "command": "chasm.searchSessions",
                "title": "Chasm: Quick Session Search",
                "icon": "$(search)",
                "category": "Chasm"
            },
            {
                "command": "chasm.recoverOrphaned",
                "title": "Chasm: Recover Orphaned Sessions",
                "icon": "$(debug-restart)",
                "category": "Chasm"
            },
            {
                "command": "chasm.previewSession",
                "title": "Chasm: Preview Session",
                "icon": "$(open-preview)",
                "category": "Chasm"
            },
            {
                "command": "chasm.toggleRecording",
                "title": "Chasm: Toggle Real-Time Recording",
                "icon": "$(record)",
                "category": "Chasm"
            },
            {
                "command": "chasm.recordingStatus",
                "title": "Chasm: Recording Status",
                "icon": "$(pulse)",
                "category": "Chasm"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "chasm",
                    "title": "Chasm",
                    "icon": "$(comment-discussion)"
                }
            ]
        },
        "views": {
            "chasm": [
                {
                    "id": "chasm.chatQuickAccess",
                    "name": "Chat",
                    "icon": "$(comment-discussion)"
                },
                {
                    "id": "chasm.workspaces",
                    "name": "Workspaces",
                    "icon": "$(folder)"
                },
                {
                    "id": "chasm.sessions",
                    "name": "Sessions",
                    "icon": "$(comment)"
                },
                {
                    "id": "chasm.health",
                    "name": "Health",
                    "icon": "$(heart)",
                    "visibility": "collapsed"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "chasm.chatQuickAccess",
                "contents": "Start a new conversation or continue an existing one.\n[Open Chasm Chat](command:chasm.openChat)\n[Run Health Check](command:chasm.doctor)"
            },
            {
                "view": "chasm.workspaces",
                "contents": "No workspaces found.\n[Refresh](command:chasm.refresh)\n[Harvest Sessions](command:chasm.harvest)"
            },
            {
                "view": "chasm.sessions",
                "contents": "Open a workspace to view sessions.\n[Show All Workspaces](command:chasm.showWorkspaces)"
            },
            {
                "view": "chasm.health",
                "contents": "Run a health check to scan for session issues.\n[Run Health Check](command:chasm.doctor)\n[Fix All Issues](command:chasm.doctorFix)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "chasm.refresh",
                    "when": "view == chasm.workspaces || view == chasm.sessions",
                    "group": "navigation"
                },
                {
                    "command": "chasm.findWorkspace",
                    "when": "view == chasm.workspaces",
                    "group": "navigation"
                },
                {
                    "command": "chasm.launchTui",
                    "when": "view == chasm.workspaces || view == chasm.sessions",
                    "group": "navigation"
                },
                {
                    "command": "chasm.doctor",
                    "when": "view == chasm.health",
                    "group": "navigation"
                },
                {
                    "command": "chasm.doctorFix",
                    "when": "view == chasm.health",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "chasm.showSessions",
                    "when": "view == chasm.workspaces && (viewItem == workspace || viewItem == workspaceWithChats)",
                    "group": "inline"
                },
                {
                    "command": "chasm.mergeSessionsForWorkspace",
                    "when": "view == chasm.workspaces && viewItem == workspaceWithChats",
                    "group": "1_sessions"
                },
                {
                    "command": "chasm.fetchSessionsForWorkspace",
                    "when": "view == chasm.workspaces && (viewItem == workspace || viewItem == workspaceWithChats)",
                    "group": "1_sessions"
                },
                {
                    "command": "chasm.exportSessions",
                    "when": "view == chasm.workspaces && (viewItem == workspace || viewItem == workspaceWithChats)",
                    "group": "2_export"
                },
                {
                    "command": "chasm.moveSessions",
                    "when": "view == chasm.workspaces && viewItem == workspaceWithChats",
                    "group": "2_export"
                },
                {
                    "command": "chasm.loadSession",
                    "when": "view == chasm.sessions && viewItem == session",
                    "group": "inline"
                },
                {
                    "command": "chasm.mergeSessionsForWorkspace",
                    "when": "view == chasm.sessions && viewItem == session",
                    "group": "1_actions"
                },
                {
                    "command": "chasm.fetchSessionsForWorkspace",
                    "when": "view == chasm.sessions && viewItem == session",
                    "group": "1_actions"
                },
                {
                    "command": "chasm.copySessionId",
                    "when": "view == chasm.sessions && viewItem == session",
                    "group": "2_info"
                },
                {
                    "command": "chasm.viewSessionDetails",
                    "when": "view == chasm.sessions && viewItem == session",
                    "group": "2_info"
                }
            ],
            "commandPalette": [
                {
                    "command": "chasm.openChat"
                },
                {
                    "command": "chasm.showWorkspaces"
                },
                {
                    "command": "chasm.showSessions"
                },
                {
                    "command": "chasm.showHistory"
                },
                {
                    "command": "chasm.findWorkspace"
                },
                {
                    "command": "chasm.exportSessions"
                },
                {
                    "command": "chasm.importSessions"
                },
                {
                    "command": "chasm.fetchHistory"
                },
                {
                    "command": "chasm.mergeHistory"
                },
                {
                    "command": "chasm.launchTui"
                },
                {
                    "command": "chasm.moveSessions"
                },
                {
                    "command": "chasm.doctor"
                },
                {
                    "command": "chasm.doctorFix"
                },
                {
                    "command": "chasm.doctorDryRun"
                },
                {
                    "command": "chasm.registerRepair"
                },
                {
                    "command": "chasm.registerRepairRecursive"
                },
                {
                    "command": "chasm.startServer"
                },
                {
                    "command": "chasm.stopServer"
                },
                {
                    "command": "chasm.recoverScan"
                },
                {
                    "command": "chasm.recoverOrphans"
                },
                {
                    "command": "chasm.syncPull"
                },
                {
                    "command": "chasm.syncPush"
                },
                {
                    "command": "chasm.upgradeFormat"
                },
                {
                    "command": "chasm.harvest"
                },
                {
                    "command": "chasm.harvestScan"
                },
                {
                    "command": "chasm.harvestSearch"
                },
                {
                    "command": "chasm.searchSessions"
                },
                {
                    "command": "chasm.recoverOrphaned"
                },
                {
                    "command": "chasm.gitInit"
                },
                {
                    "command": "chasm.gitAdd"
                },
                {
                    "command": "chasm.gitStatus"
                },
                {
                    "command": "chasm.gitSnapshot"
                },
                {
                    "command": "chasm.createMigration"
                },
                {
                    "command": "chasm.restoreMigration"
                },
                {
                    "command": "chasm.showVersion"
                },
                {
                    "command": "chasm.toggleRecording"
                },
                {
                    "command": "chasm.recordingStatus"
                }
            ]
        },
        "keybindings": [
            {
                "command": "chasm.openChat",
                "key": "ctrl+shift+;",
                "mac": "cmd+shift+;"
            },
            {
                "command": "chasm.doctor",
                "key": "ctrl+shift+h",
                "mac": "cmd+shift+h"
            },
            {
                "command": "chasm.searchSessions",
                "key": "ctrl+shift+/",
                "mac": "cmd+shift+/"
            },
            {
                "command": "chasm.harvest",
                "key": "ctrl+shift+\\",
                "mac": "cmd+shift+\\"
            },
            {
                "command": "chasm.refresh",
                "key": "ctrl+shift+r",
                "mac": "cmd+shift+r",
                "when": "view == chasm.workspaces || view == chasm.sessions"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run copy-binary",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "test:unit": "mocha --require ts-node/register src/test/suite/*.test.ts",
        "copy-binary": "node scripts/copy-binary.js"
    },
    "files": [
        "out/**/*",
        "bin/**/*",
        "resources/**/*"
    ],
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^20.x",
        "@types/mocha": "^10.0.6",
        "@types/glob": "^8.1.0",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "@vscode/test-electron": "^2.3.8",
        "eslint": "^8.54.0",
        "glob": "^10.3.10",
        "mocha": "^10.2.0",
        "typescript": "^5.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nervosys/chasm.git"
    },
    "license": "AGPL-3.0-only"
}