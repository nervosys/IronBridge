<idea-plugin>
    <id>io.ironbridge.plugin</id>
    <name>IronBridge - Chat Session Manager</name>
    <version>1.0.0</version>
    <vendor email="hello@nervosys.ai" url="https://github.com/nervosys/IronBridge">Nervosys LLC</vendor>

    <description><![CDATA[
    <h2>IronBridge - Universal Chat Session Manager</h2>
    <p>Harvest, view, and manage AI chat sessions from JetBrains AI Assistant and other providers.</p>
    
    <h3>Features</h3>
    <ul>
        <li>📥 Harvest chat sessions from JetBrains AI Assistant</li>
        <li>📊 View session history with full message content</li>
        <li>🔍 Search across all your AI conversations</li>
        <li>🏷️ Tag and organize sessions</li>
        <li>📤 Export sessions to Markdown, JSON, or HTML</li>
        <li>🔄 Sync with IronBridge server for cross-tool access</li>
    </ul>
    
    <h3>Quick Start</h3>
    <ol>
        <li>Install the plugin</li>
        <li>Open the IronBridge tool window (View → Tool Windows → IronBridge)</li>
        <li>Click "Harvest" to import your chat sessions</li>
    </ol>
    
    <p>Part of the IronBridge ecosystem for unified AI chat management.</p>
    ]]></description>

    <change-notes><![CDATA[
    <h3>1.0.0</h3>
    <ul>
        <li>Initial release</li>
        <li>JetBrains AI Assistant session harvesting</li>
        <li>Session viewer and search</li>
        <li>IronBridge server integration</li>
    </ul>
    ]]></change-notes>

    <!-- Product compatibility -->
    <idea-version since-build="233" until-build="243.*"/>

    <!-- Plugin dependencies -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow id="IronBridge" 
                    secondary="true" 
                    icon="/icons/ironbridge.svg"
                    anchor="right"
                    factoryClass="io.ironbridge.plugin.ui.IronBridgeToolWindowFactory"/>

        <!-- Settings -->
        <applicationConfigurable 
            parentId="tools"
            instance="io.ironbridge.plugin.settings.IronBridgeSettingsConfigurable"
            id="io.ironbridge.plugin.settings"
            displayName="IronBridge"/>

        <!-- Application Service -->
        <applicationService 
            serviceImplementation="io.ironbridge.plugin.services.IronBridgeService"/>

        <!-- Project Service -->
        <projectService 
            serviceImplementation="io.ironbridge.plugin.services.IronBridgeProjectService"/>

        <!-- Notifications -->
        <notificationGroup id="IronBridge Notifications" 
                          displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Add to Tools menu -->
        <group id="IronBridge.ToolsMenu" text="IronBridge" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            
            <action id="IronBridge.Harvest"
                    class="io.ironbridge.plugin.actions.HarvestAction"
                    text="Harvest Sessions"
                    description="Import AI chat sessions"
                    icon="/icons/harvest.svg"/>
                    
            <action id="IronBridge.Search"
                    class="io.ironbridge.plugin.actions.SearchAction"
                    text="Search Sessions"
                    description="Search across all chat sessions"
                    icon="/icons/search.svg"/>
                    
            <action id="IronBridge.Sync"
                    class="io.ironbridge.plugin.actions.SyncAction"
                    text="Sync with Server"
                    description="Synchronize with IronBridge server"
                    icon="/icons/sync.svg"/>
                    
            <separator/>
            
            <action id="IronBridge.Settings"
                    class="io.ironbridge.plugin.actions.OpenSettingsAction"
                    text="Settings"
                    description="Open IronBridge settings"/>
        </group>

        <!-- Editor context menu -->
        <action id="IronBridge.SaveToSession"
                class="io.ironbridge.plugin.actions.SaveToSessionAction"
                text="Save Selection to IronBridge"
                description="Save selected code to a IronBridge session">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
