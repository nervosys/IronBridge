{
  "name": "@ironbridge/shared",
  "version": "2.0.1",
  "description": "Shared types, API client, and utilities for IRONBRIDGE web and mobile apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.mjs",
      "require": "./dist/sync/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "ironbridge",
    "chat-session-manager",
    "api",
    "types"
  ],
  "license": "AGPL-3.0-only OR LicenseRef-IronBridge-Commercial"
}
