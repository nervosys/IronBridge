# Example terraform.tfvars - Copy to terraform.tfvars and customize

aws_region     = "us-east-1"
environment    = "prod"
project_name   = "chasm-telemetry"
retention_days = 90

# Enable DynamoDB for real-time queries (increases cost)
enable_dynamodb = false

# CORS allowed origins (use specific domains in production)
allowed_origins = ["*"]
